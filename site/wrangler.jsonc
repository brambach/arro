// Saunafam's website: a Worker with static assets, on saunafam.com.
// Files in public/ are served as they are. worker.js runs first for pages
// and the API: it sends arrofamily.com and www to https://saunafam.com and
// serves /join/<code>. It never runs for the asset paths listed below.
// See README.md. Deploying is Bryce's step only.
{
  "name": "saunafam",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs first for pages and the API. It never runs for the
    // files below, so they're served free and don't count toward the daily
    // Worker request limit. Add any new asset folder here (assets.test.mjs
    // fails until you do).
    "run_worker_first": [
      "/*",
      "!/art/*", "!/fonts/*", "!/og/*", "!/licenses/*",
      "!/styles.css", "!/site.js",
      "!/favicon.*", "!/apple-touch-icon.png", "!/icon-512.png"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Custom domains: Wrangler creates the DNS records and certificates.
  // The arrofamily.com pair stays so its 301 to saunafam.com keeps working
  // (keep it for at least 12 months, to October 2027).
  "routes": [
    { "pattern": "saunafam.com", "custom_domain": true },
    { "pattern": "www.saunafam.com", "custom_domain": true },
    { "pattern": "arrofamily.com", "custom_domain": true },
    { "pattern": "www.arrofamily.com", "custom_domain": true }
  ],
  // No *.workers.dev copy of the site.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
