// Arro's website: a Worker with static assets, on arrofamily.com.
// Files in public/ are served as they are. worker.js runs first to send
// www to the apex and to serve /join/<code> links. See README.md.
{
  "name": "arrofamily",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Custom domains: Wrangler creates the DNS records and certificates.
  "routes": [
    { "pattern": "arrofamily.com", "custom_domain": true },
    { "pattern": "www.arrofamily.com", "custom_domain": true }
  ],
  // No *.workers.dev copy of the site.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
