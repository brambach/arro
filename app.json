{
  "expo": {
    "name": "Saunafam",
    "slug": "arro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arrofamily.arro",
      "buildNumber": "9",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/brand/out/icon-1024.png",
        "dark": "./assets/brand/out/icon-dark-1024.png",
        "tinted": "./assets/brand/out/icon-tinted-1024.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EFE6D8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/FrauncesSoft-Regular.ttf",
            "./assets/fonts/FrauncesSoft-SemiBold.ttf"
          ]
        }
      ],
      "expo-apple-authentication",
      [
        "@appeeky/expo-healthkit",
        {
          "healthSharePermission": false,
          "healthUpdatePermission": "Saunafam saves your sauna sessions to Apple Health as mindful minutes, if you turn it on. It never reads your Health data.",
          "isBackgroundDeliveryEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Saunafam uses a photo only when you pick one for your profile or a session. Your family sees it in Saunafam.",
          "cameraPermission": "Saunafam uses the camera only when you take a photo for a session. Your family sees it in Saunafam.",
          "microphonePermission": false
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EFE6D8",
          "image": "./assets/brand/out/splash-transparent.png",
          "imageWidth": 64,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          { "name": "NightStone", "ios": "./assets/brand/out/alt/icon-night-1024.png" },
          { "name": "Cedar", "ios": "./assets/brand/out/alt/icon-cedar-1024.png" },
          { "name": "Lake", "ios": "./assets/brand/out/alt/icon-lake-1024.png" }
        ]
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6540bde3-31ae-4511-8506-8604be1f7820"
      }
    },
    "owner": "brycerambach"
  }
}
