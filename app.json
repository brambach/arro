{
  "expo": {
    "name": "Arro",
    "slug": "arro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arrofamily.arro",
      "buildNumber": "8",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/brand/out/icon-1024.png",
        "dark": "./assets/brand/out/icon-dark-1024.png",
        "tinted": "./assets/brand/out/icon-tinted-1024.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EFE6D8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/FrauncesSoft-Regular.ttf",
            "./assets/fonts/FrauncesSoft-SemiBold.ttf"
          ]
        }
      ],
      "expo-apple-authentication",
      [
        "@appeeky/expo-healthkit",
        {
          "healthSharePermission": "Arro reads your workouts from Apple Health, including distance and route, so moving counts toward your family streak and your family can see what you did. Routes are shared only with your family, with the start and end left off. Arro only reads today's and yesterday's workouts.",
          "healthUpdatePermission": "Arro never writes to Apple Health. It only reads your workouts so moving counts toward your family streak.",
          "isBackgroundDeliveryEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Arro uses a photo only when you pick one for your profile or a workout. Your family sees it in Arro.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EFE6D8",
          "image": "./assets/brand/out/splash-transparent.png",
          "imageWidth": 64,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6540bde3-31ae-4511-8506-8604be1f7820"
      }
    },
    "owner": "brycerambach"
  }
}
