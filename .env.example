# Copy this file to .env.local and fill in your own values. .env.local is git ignored.
#
# The app (read by Expo at build time, see src/state/supabase.ts).
# Both come from your Supabase project: Project Settings > API. The anon key is
# meant to be public; row level security in supabase/migrations keeps families
# private. Leave both empty to run a dev build on a local preview family.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Edge functions. These don't go in .env.local. Set them on your project with
#   npx supabase secrets set NAME=value
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by
# the Supabase edge runtime, so you never set them yourself.
#
# send-push: only if you turn on push security in your Expo project.
# EXPO_ACCESS_TOKEN=your-expo-access-token
#
# delete-account: optional, for revoking the Sign in with Apple token when
# someone deletes their account. Without all four, that step is skipped.
# APPLE_TEAM_ID=YOURTEAMID
# APPLE_CLIENT_ID=com.example.arro
# APPLE_KEY_ID=YOURKEYID
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#
# Database (Supabase Vault, not an env var). pg_cron calls send-push using two
# Vault secrets named project_url and anon_key. Without them pushes stay queued.
# See supabase/migrations/20261005000008_evening_nudge.sql.
